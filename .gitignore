# ==========================================
# Локальная база данных (на хостинге будет своя)
db.sqlite3
db.sqlite3-journal

# Папка, куда collectstatic собирает файлы (на хостинге соберется заново)
staticfiles/

# Загруженные пользователями файлы (картинки туров)
media/

# Локальные настройки (если вы что-то меняли только для себя)
local_settings.py

